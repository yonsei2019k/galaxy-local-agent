<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="ziphap-website-vault-v1.xml" />
        <exclude domain="sharedpref" path="ziphap-website-session-keys-v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="ziphap-website-vault-v1.xml" />
        <exclude domain="sharedpref" path="ziphap-website-session-keys-v1.xml" />
    </device-transfer>
</data-extraction-rules>
