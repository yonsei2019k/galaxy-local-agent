<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional assistant usage analysis uses Settings/AppOps, never a runtime grant.
         Image-only consumers remove this unused capability from their merged manifest. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Components and the remaining permissions belong to the consuming app. -->
    <application>
        <meta-data android:name="com.user.localagent.UPDATE_URL" android:value="${ziphapUpdateUrl}" />
    </application>
</manifest>
