{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ziphap:device-bridge:v1",
  "title": "Experimental authenticated device bridge v1",
  "oneOf": [
    {"$ref": "#/$defs/register"}, {"$ref": "#/$defs/propose"},
    {"$ref": "#/$defs/claim"}, {"$ref": "#/$defs/report"},
    {"$ref": "#/$defs/control"}, {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/callView"}, {"$ref": "#/$defs/error"},
    {"$ref": "#/$defs/planProposal"}, {"$ref": "#/$defs/planAck"}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18},
    "capability": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,512}$", "writeOnly": true},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "description": {"type": "string", "maxLength": 2048},
        "inputSchema": {"type": "object"}
      }
    },
    "register": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "parentRunId", "projectBinding", "authorityRevision", "allowExternalAgent", "expiresAfterMs", "phoneTools", "pcWorkspaceProfile", "requestDigest"],
      "properties": {
        "version": {"const": 1}, "parentRunId": {"$ref": "#/$defs/uuid"},
        "projectBinding": {"type": "string", "minLength": 1, "maxLength": 256},
        "authorityRevision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "allowExternalAgent": {"const": true},
        "requirePlan": {"type": "boolean", "default": false},
        "expiresAfterMs": {"type": "integer", "minimum": 1000, "maximum": 900000},
        "phoneTools": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/tool"}},
        "pcWorkspaceProfile": {"type": ["string", "null"]}, "requestDigest": {"$ref": "#/$defs/sha"}
      }
    },
    "planProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "requiredTools", "constraints"],
      "properties": {
        "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
        "requiredTools": {"type": "array", "uniqueItems": true, "maxItems": 12, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
        "constraints": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
      },
      "$comment": "Host additionally checks UTF-16 code-unit bounds and selected names in this immutable session catalog. Lists retain original order."
    },
    "planAck": {
      "type": "object", "additionalProperties": false, "required": ["planDigest", "accepted"],
      "properties": {"planDigest": {"$ref": "#/$defs/sha"}, "accepted": {"type": "boolean"}}
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "planDigest", "requestDigest", "goal", "requiredTools", "constraints"],
      "properties": {
        "state": {"enum": ["AWAITING_HOST", "ACCEPTED", "REJECTED"]},
        "planDigest": {"$ref": "#/$defs/sha"}, "requestDigest": {"$ref": "#/$defs/sha"},
        "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
        "requiredTools": {"type": "array", "uniqueItems": true, "maxItems": 12, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
        "constraints": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
      }
    },
    "propose": {
      "type": "object", "additionalProperties": false, "required": ["callId", "tool", "arguments"],
      "properties": {"callId": {"$ref": "#/$defs/uuid"}, "tool": {"type": "string"}, "arguments": {"type": "object"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["callId", "sequence", "revision"],
      "properties": {"callId": {"$ref": "#/$defs/uuid"}, "sequence": {"$ref": "#/$defs/sequence"}, "revision": {"$ref": "#/$defs/revision"}}
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["success", "content", "verification", "effectNotApplied"],
      "properties": {
        "success": {"type": "boolean"}, "content": {"type": "string", "maxLength": 131072},
        "verification": {"enum": ["VERIFIED", "PREPARED", "UNVERIFIED", "FAILED"]}, "effectNotApplied": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"effectNotApplied": {"const": true}}}, "then": {"properties": {"success": {"const": false}, "verification": {"const": "FAILED"}}}},
        {"if": {"properties": {"verification": {"enum": ["VERIFIED", "PREPARED"]}}}, "then": {"properties": {"success": {"const": true}}}}
      ]
    },
    "report": {
      "type": "object", "additionalProperties": false, "required": ["callId", "sequence", "revision", "result"],
      "properties": {"callId": {"$ref": "#/$defs/uuid"}, "sequence": {"$ref": "#/$defs/sequence"}, "revision": {"$ref": "#/$defs/revision"}, "result": {"$ref": "#/$defs/result"}}
    },
    "control": {"type": "object", "additionalProperties": false, "required": ["revision"], "properties": {"revision": {"$ref": "#/$defs/revision"}}},
    "pending": {
      "type": "object", "additionalProperties": false,
      "required": ["callId", "sequence", "state", "tool", "arguments", "requestDigest", "projectBinding", "authorityRevision"],
      "properties": {
        "callId": {"$ref": "#/$defs/uuid"}, "sequence": {"$ref": "#/$defs/sequence"},
        "state": {"enum": ["QUEUED", "CLAIMED", "UNKNOWN_EFFECT"]}, "tool": {"type": "string"}, "arguments": {"type": "object"},
        "requestDigest": {"$ref": "#/$defs/sha"}, "projectBinding": {"type": "string", "minLength": 1, "maxLength": 256},
        "authorityRevision": {"type": "integer", "minimum": 0}, "claimRevision": {"$ref": "#/$defs/revision"}
      }
    },
    "ack": {
      "type": "object", "additionalProperties": false, "required": ["callId", "sequence", "resultDigest"],
      "properties": {"callId": {"$ref": "#/$defs/uuid"}, "sequence": {"$ref": "#/$defs/sequence"}, "resultDigest": {"$ref": "#/$defs/sha"}}
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "revision", "state", "expiresAtEpochMs", "lastSequence", "allowExternalAgent", "tools", "pendingCall", "restartPolicy"],
      "properties": {
        "sessionId": {"$ref": "#/$defs/uuid"}, "revision": {"$ref": "#/$defs/revision"},
        "state": {"enum": ["ACTIVE", "CANCELLING", "REVOKED", "CLOSED", "EXPIRED"]},
        "expiresAtEpochMs": {"type": "integer", "minimum": 1}, "lastSequence": {"type": "integer", "minimum": 0, "maximum": 18},
        "allowExternalAgent": {"const": true}, "tools": {"type": "array", "maxItems": 34, "items": {"$ref": "#/$defs/tool"}},
        "pendingCall": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pending"}]},
        "restartPolicy": {"const": "RAM_ONLY_RESTART_REVOKES"}, "phoneCapability": {"$ref": "#/$defs/capability"}, "resultAck": {"$ref": "#/$defs/ack"},
        "requiresPlan": {"const": true}, "plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/plan"}]}
      },
      "dependentRequired": {"requiresPlan": ["plan"], "plan": ["requiresPlan"]}
    },
    "callView": {
      "type": "object", "additionalProperties": false, "required": ["callId", "sequence", "state"],
      "properties": {
        "callId": {"$ref": "#/$defs/uuid"}, "sequence": {"$ref": "#/$defs/sequence"},
        "state": {"enum": ["QUEUED", "CLAIMED", "RUNNING", "COMPLETED", "CANCELLED", "UNKNOWN_EFFECT"]},
        "result": {"$ref": "#/$defs/result"}, "resultSource": {"enum": ["PHONE_EXECUTOR", "PC_WORKSPACE"]}
      },
      "dependentRequired": {"result": ["resultSource"], "resultSource": ["result"]}
    },
    "error": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "string", "pattern": "^[A-Z_]+$"}}}
  }
}
