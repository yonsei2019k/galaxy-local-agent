{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZipHap offline prototype host-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "request_id",
    "scope",
    "epoch",
    "expected_revision",
    "request_digest",
    "event",
    "result_digest"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "host_observation"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "event": {
      "type": "string",
      "enum": [
        "effect_verified",
        "effect_unknown",
        "not_applied",
        "cancel_ack"
      ]
    },
    "result_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "effect_verified"
          }
        }
      },
      "then": {
        "properties": {
          "result_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "else": {
        "properties": {
          "result_digest": {
            "type": "null"
          }
        }
      }
    }
  ]
}
